# Rust build
target/
**/*.rs.bk
Cargo.lock.bak

# Local secrets — never commit
.env
.env.local
.env.*.local

# Cache root (per README §5.4). `/data` also covers the case where data/ is a
# symlink to external storage (e.g. the Samsung T7 at /mnt/atlas) — the
# trailing-slash form matches only directories, not a symlink.
data/
/data

# Python (validation scripts)
__pycache__/
*.pyc

# Scratch run logs from analysis scripts
scripts/_*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
